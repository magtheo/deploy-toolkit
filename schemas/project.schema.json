{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magtheo/deploy-toolkit/schemas/project.schema.json",
  "title": "Project",
  "description": "Declares how a project is built into releases and how a release is applied to a target. This schema is a public contract (Consumer Contract v1).",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "artifacts", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "deploy.toolkit/v1" },
    "kind": { "const": "Project" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["branch"],
          "additionalProperties": false,
          "properties": {
            "branch": { "type": "string", "minLength": 1 }
          }
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "repository"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "oci" },
          "repository": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["apply"],
      "additionalProperties": false,
      "properties": {
        "preflight": { "$ref": "#/$defs/lifecycleStep" },
        "migrate": { "$ref": "#/$defs/lifecycleStep" },
        "apply": { "$ref": "#/$defs/lifecycleStep" },
        "verify": { "$ref": "#/$defs/lifecycleStep" },
        "rollback": { "$ref": "#/$defs/lifecycleStep" }
      }
    }
  },
  "$defs": {
    "lifecycleStep": {
      "type": "object",
      "required": ["argv"],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
