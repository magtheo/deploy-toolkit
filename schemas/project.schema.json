{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magtheo/deploy-toolkit/schemas/project.schema.json",
  "title": "Project",
  "description": "Declares how a project is built into releases and how a release is applied to a target. This schema is part of the candidate Consumer Contract v1.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "release", "artifacts", "bundle", "lifecycle"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "deploy.toolkit/v1" },
    "kind": { "const": "Project" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "requiredChecks"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["type", "repository", "branch"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "github" },
            "repository": { "type": "string", "$comment": "GitHub owner/repo (SCM identity, not a registry)", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$" },
            "branch": { "type": "string", "minLength": 1 }
          }
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "repository"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "oci" },
          "repository": {
            "type": "string",
            "$comment": "OCI repository name WITHOUT tag or digest; releases pin the digest separately",
            "pattern": "^((?:[a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9])(?:\\.(?:[a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]))*(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|[-]*)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|[-]*)[a-z0-9]+)*)*$"
          }
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "$comment": "gitignore-style glob relative to the repository root at the release revision; '*' and '**' only as whole path segments",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(/([A-Za-z0-9_.-]+|\\*{1,2}))*$"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["apply", "verify"],
      "additionalProperties": false,
      "properties": {
        "preflight": { "$ref": "#/$defs/lifecycleStep" },
        "migrate": { "$ref": "#/$defs/lifecycleStep" },
        "apply": { "$ref": "#/$defs/lifecycleStep" },
        "verify": { "$ref": "#/$defs/lifecycleStep" },
        "rollback": { "$ref": "#/$defs/lifecycleStep" }
      }
    }
  },
  "$defs": {
    "lifecycleStep": {
      "type": "object",
      "required": ["argv"],
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
