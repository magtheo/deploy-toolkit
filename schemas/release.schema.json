{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/magtheo/deploy-toolkit/schemas/release.schema.json",
  "title": "Release",
  "description": "An immutable release: source revision, exact artifact digests, bundle digest, deployment contract digest and migration semantics. Normally generated by deployctl, not hand-written.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "source", "artifacts", "bundle", "deploymentContract", "migration"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "deploy.toolkit/v1" },
    "kind": { "const": "Release" },
    "metadata": {
      "type": "object",
      "required": ["project", "version"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "version": {
          "type": "string",
          "$comment": "strict SemVer (semver.org)",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "repository", "revision"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "github" },
        "repository": { "type": "string", "$comment": "GitHub owner/repo (SCM identity, not a registry)", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$" },
        "revision": { "type": "string", "$comment": "full git commit SHA (SHA-1 or SHA-256 repositories)", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "image", "digest"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "oci" },
          "image": {
            "type": "string",
            "$comment": "OCI repository name WITHOUT tag or digest; the digest field is the only mutable-ref-free pointer",
            "pattern": "^((?:[a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9])(?:\\.(?:[a-zA-Z0-9]|[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]))*(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|[-]*)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|[-]*)[a-z0-9]+)*)*$"
          },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "bundle": {
      "type": "object",
      "required": ["digest"],
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "deploymentContract": {
      "type": "object",
      "required": ["digest"],
      "additionalProperties": false,
      "properties": {
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "migration": {
      "type": "object",
      "required": ["head", "mode", "rollbackSafe"],
      "additionalProperties": false,
      "properties": {
        "head": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["none", "forward-compatible", "maintenance-required", "irreversible"] },
        "rollbackSafe": { "type": "boolean" }
      },
      "if": { "properties": { "mode": { "const": "irreversible" } } },
      "then": { "properties": { "rollbackSafe": { "const": false } } }
    }
  }
}
